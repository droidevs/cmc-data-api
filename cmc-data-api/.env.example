APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CORS_ALLOWED_ORIGINS="${APP_URL}"
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=600

SECURITY_TRUSTED_ORIGINS="${APP_URL}"
SECURITY_ENFORCE_API_ORIGIN=true
SECURITY_REQUIRE_API_ORIGIN_HEADER=false
SECURITY_ALLOW_SAME_SITE_WRITES=true
SECURITY_REQUEST_ID_HEADER=X-Request-Id

CSRF_ORIGIN_ONLY=false
CSRF_ALLOW_SAME_SITE=false

API_READ_RATE_LIMIT_PER_MINUTE=120
API_READ_RATE_LIMIT_PER_HOUR=1500
API_WRITE_RATE_LIMIT_PER_MINUTE=30
API_WRITE_RATE_LIMIT_PER_HOUR=300
API_ROUTE_RATE_LIMIT_PER_MINUTE=60
WEB_RATE_LIMIT_PER_MINUTE=180

AUDIT_LOG_ENABLED=true
AUDIT_LOG_CHANNEL=audit
AUDIT_LOG_LEVEL=info
AUDIT_LOG_DAYS=90
AUDIT_LOG_READ_FAILURES=true
AUDIT_LOG_INCLUDE_INPUT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cmc_data_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

DATA_CACHE_ENABLED=true
DATA_CACHE_STORE=redis
DATA_CACHE_TTL=600
DATA_CACHE_LOCK_SECONDS=10
DATA_CACHE_LOCK_WAIT_SECONDS=3
DATA_CACHE_AUTHENTICATED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
